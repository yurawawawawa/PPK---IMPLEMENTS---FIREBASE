rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /students/{studentId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.keys().hasAll(['nama', 'nim', 'prodi', 'createdAt'])
        && request.resource.data.keys().hasOnly(['nama', 'nim', 'prodi', 'createdAt'])
        && request.resource.data.nama is string
        && request.resource.data.nama.size() > 0
        && request.resource.data.nama.size() <= 100
        && request.resource.data.nim is string
        && request.resource.data.nim.matches('^[0-9]{5,20}$')
        && request.resource.data.prodi is string
        && request.resource.data.prodi.size() > 0
        && request.resource.data.prodi.size() <= 100
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }
  }
}
